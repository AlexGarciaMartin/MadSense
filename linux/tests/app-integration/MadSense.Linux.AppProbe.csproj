<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../vendor/DualSenseClient/DualSenseClient.Controllers/DualSenseClient.Controllers.csproj" />
    <Compile Include="../../app/LinuxBridgeController.cs" Link="Production/LinuxBridgeController.cs" />
    <Compile Include="../../app/LinuxText.cs" Link="Production/LinuxText.cs" />
    <Compile Include="../../app/Preferences.cs" Link="Production/Preferences.cs" />
    <Compile Include="../../platform/*.cs" Link="Production/Platform/%(Filename)%(Extension)" />
    <Compile Include="../../../macos/backend/ActivityHidDevice.cs" Link="Production/ActivityHidDevice.cs" />
    <Compile Include="../../../src/Localization.cs" Link="Production/Localization.cs" />
    <EmbeddedResource Include="../../../src/Localization/*.json" LogicalName="MadSense.Localization.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
