<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MadSense.Linux</AssemblyName>
    <RootNamespace>MadSense</RootNamespace>
    <Version>0.5.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.2" />
    <ProjectReference Include="../../vendor/DualSenseClient/DualSenseClient.Controllers/DualSenseClient.Controllers.csproj" />
    <Compile Include="../../src/Localization.cs" Link="Localization.cs" />
    <EmbeddedResource Include="../../src/Localization/*.json" LogicalName="MadSense.Localization.%(Filename)%(Extension)" WithCulture="false" />
    <AvaloniaResource Include="Assets/**" />
    <Compile Include="../platform/*.cs" Link="Platform/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
