[Unit]
Description=MadSense controller isolation and local USB-IP broker
After=systemd-udevd.service polkit.service
Requires=systemd-udevd.service

[Service]
Type=notify
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/libexec/madsense/broker.py --serve
ExecStopPost=/usr/bin/python3 -I /usr/libexec/madsense/broker.py --recover
Restart=on-failure
RestartSec=1
WatchdogSec=15
WatchdogSignal=SIGKILL
RuntimeDirectory=madsense
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
FileDescriptorStoreMax=33
FileDescriptorStorePreserve=yes
NotifyAccess=main
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/madsense /run/udev /dev /sys/devices/platform
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET
LockPersonality=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_SYS_PTRACE
RestrictNamespaces=yes
TimeoutStopSec=20
# The helper must inspect the host /proc and device nodes. PrivateDevices,
# PrivateUsers and ProtectProc would invalidate the foreign-descriptor audit.

[Install]
WantedBy=multi-user.target
