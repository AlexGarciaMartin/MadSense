<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>MadSense</AssemblyName><Version>0.5.6</Version>
    <ApplicationIcon>assets/madsense.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization/*.json" WithCulture="false" LogicalName="MadSense.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Games/catalog.json" WithCulture="false" LogicalName="MadSense.Games.catalog.json" />
    <ProjectReference Include="../vendor/DualSenseClient/DualSenseClient.Controllers/DualSenseClient.Controllers.csproj" />
    <ProjectReference Include="../vendor/DualSenseClient/DualSenseClient.HidHide/DualSenseClient.HidHide.csproj" />
    <None Update="InstallerProtocol.json" TargetPath="MadSense.installer.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>


